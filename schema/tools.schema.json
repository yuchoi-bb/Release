{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yuchoi-bb/Release/schema/tools.schema.json",
  "title": "ToolHub Release catalog",
  "type": "object",
  "required": ["schema_version", "tools"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "hub": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "tagline": { "type": "string" },
        "description": { "type": "string" },
        "download_base": { "type": "string" },
        "updated_at": { "type": "string" }
      }
    },
    "tools": {
      "type": "array",
      "items": { "$ref": "#/$defs/tool" }
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "required": ["tool", "obs_prefix", "os_supported", "releases"],
      "additionalProperties": false,
      "properties": {
        "tool": { "type": "string", "minLength": 1 },
        "obs_prefix": { "type": "string", "minLength": 1 },
        "os_supported": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "Display string per OS, e.g. 'Windows (x64, x86, arm64)'. Parsed into os + arch list for filtering."
        },
        "summary": { "type": "string" },
        "category": { "type": "string" },
        "maintainer": { "type": "string" },
        "repo_url": { "type": "string" },
        "docs_url": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "releases": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/release" }
        }
      }
    },
    "release": {
      "type": "object",
      "required": ["version", "channel", "released_at", "verification", "assets"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "channel": { "enum": ["stable", "rc", "beta", "alpha"] },
        "released_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "notes": { "type": "string" },
        "notes_url": { "type": "string" },
        "verification": { "$ref": "#/$defs/verification" },
        "assets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/asset" }
        }
      }
    },
    "verification": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["verified", "pending", "unverified"] },
        "verified_at": { "type": "string" },
        "verified_by": { "type": "string" },
        "method": { "type": "string" },
        "ticket": { "type": "string" }
      }
    },
    "asset": {
      "type": "object",
      "required": ["file", "os", "arch", "sha256"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "os": { "enum": ["windows", "linux", "macos"] },
        "arch": { "enum": ["x64", "x86", "arm64", "arm", "universal"] },
        "size": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "url": { "type": "string" },
        "sig_url": { "type": "string" }
      }
    }
  }
}
