{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yuchoi-bb/Release/schema/tools.schema.json",
  "title": "ToolHub Release — tools.json",
  "description": "도구 메타데이터입니다. 버전·다운로드 링크·검증 리포트는 여기 적지 않습니다. OBS 에 올라간 파일을 obs_prefix 로 매칭해 페이지가 자동으로 채웁니다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tools"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "구조가 바뀌면 올립니다."
    },
    "updated_at": {
      "type": "string",
      "description": "마지막 저장 시각(UTC, ISO 8601). 페이지가 저장할 때 자동으로 채웁니다."
    },
    "tools": {
      "type": "array",
      "items": { "$ref": "#/$defs/tool" }
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tool", "obs_prefix"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "이력 추적용 불변 키. 도구명이 바뀌어도 그대로 둡니다."
        },
        "tool": {
          "type": "string",
          "minLength": 1,
          "description": "화면에 표시되는 도구명."
        },
        "obs_prefix": {
          "type": "string",
          "minLength": 1,
          "description": "OBS 파일명 접두. 이 값으로 시작하는 파일이 이 도구의 산출물로 잡힙니다."
        },
        "os_supported": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "표시용 문자열. 예: \"Windows (x64, x86, arm64)\""
        },
        "product_supported": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "지원 제품군. 예: \"PM1743\""
        },
        "manual": {
          "type": "array",
          "items": { "$ref": "#/$defs/link" }
        },
        "remarks_text": {
          "type": "string",
          "description": "비고에 표시할 짧은 문구. 예: \"Emergency Fix\""
        },
        "remarks_links": {
          "type": "array",
          "items": { "$ref": "#/$defs/link" },
          "description": "비고에 함께 표시할 링크. 예: Git Repo"
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "label": {
          "type": "string",
          "description": "비우면 URL 이 그대로 표시됩니다."
        },
        "url": {
          "type": "string",
          "pattern": "^https?://",
          "description": "http 또는 https 만 허용합니다. 다른 스킴은 링크로 만들지 않습니다."
        }
      }
    }
  }
}
